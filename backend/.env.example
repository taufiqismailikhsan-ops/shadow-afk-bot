# Required: use a long random secret; paste the same value into the dashboard settings.
API_TOKEN=replace-with-a-long-random-secret

# Backend web server
PORT=3000
# Optional: comma-separated allowed dashboard origins, e.g. https://shadowx-afk.netlify.app
# Leave empty to allow any origin; API_TOKEN is still required for private API/socket actions.
ALLOWED_ORIGINS=

# Default Minecraft connection (can also be changed from dashboard)
MC_HOST=play.example.net
MC_PORT=25565
MC_USERNAME=ShadowXBot
MC_VERSION=1.21.11
MC_AUTH=offline
AUTO_RECONNECT=true
RECONNECT_DELAY_MS=10000
ANTI_AFK=false
